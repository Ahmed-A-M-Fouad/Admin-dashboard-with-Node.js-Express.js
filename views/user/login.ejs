<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link rel="stylesheet" href="css/login_reg.css">
    <link rel="shortcut icon" href="/img/me.jpeg" type="image/x-icon">

</head>
<body>

  <div class="auth-shell">

    <!-- Dark schema panel -->
    <aside class="auth-panel">
      <div class="brand">
        <span class="brand-mark">users_db</span>
        <h1>Welcome<br>back.</h1>
        <p>Sign in to pick up right where your record left off.</p>
      </div>

      <div class="schema-preview">
        <div><span class="field">email</span> <span class="type">String</span></div>
        <div><span class="field">password</span> <span class="type">String</span></div>
      </div>

      <div class="query-line">
        <span class="prompt">users_db&gt;</span> db.users.findOne({ email })<span class="cursor"></span>
      </div>
    </aside>

    <!-- Form panel -->
    <main class="form-panel">
      <div class="form-card">

        <div class="form-card-header">
          <h2>Log in</h2>
          <span class="record-counter"><strong id="fieldCount">0</strong>/2 fields</span>
        </div>

        <form method="" action="#" id="registerForm">

          <div class="field-group">
            <span class="field-tag">email</span>
            <input type="email" name="email" placeholder="you@example.com" required>
          </div>

          <div class="field-group">
            <span class="field-tag">password</span>
            <input type="password" name="password" placeholder="••••••••" required>
          </div>

          <button type="submit" class="submit-btn">Log in</button>
        </form>

        <p class="switch-line">
          Don't have an account? <a href="register.html">Register</a>
        </p>

      </div>
    </main>

  </div>

  <script src="js/auth.js"></script>
</body>
</html>
